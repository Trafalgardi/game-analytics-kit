# Secrets for game-analytics-kit. Copy this file to analytics/.env (git-ignored) and fill it in,
# or put the same line into ~/.config/game-analytics-kit/.env to share one token between projects.
# An environment variable with the same name wins over both files. Never commit a real token.

# AppMetrica OAuth token of the Yandex account that owns the app, with the appmetrica:read scope.
# The analytics-connect-appmetrica skill walks through issuing it (oauth.yandex.ru: create an app
# with the "Web services" platform and the AppMetrica -> appmetrica:read permission, then open
# https://oauth.yandex.ru/authorize?response_type=token&client_id=<ClientID> and copy access_token).
APPMETRICA_TOKEN=
